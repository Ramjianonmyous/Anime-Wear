# Backend Environment Variables
# Copy this file to .env and fill in your values. NEVER commit .env to Git.

PORT=5000
NODE_ENV=production

# MongoDB Atlas connection string
# Create a cluster at https://cloud.mongodb.com and get the connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/<dbname>

# Razorpay Keys — get from https://dashboard.razorpay.com/app/keys
# Use test keys for testing, live keys for real payments
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin panel secret — must match VITE_ADMIN_KEY in frontend .env
# Use a strong random string (e.g. openssl rand -hex 32)
ADMIN_SECRET_KEY=your-strong-random-secret-here

# Your production frontend domain (e.g. https://animewear.in)
ALLOWED_ORIGIN=https://animewear.in

# Firebase Admin SDK — Required in production for token signature verification
# Download from Firebase Console > Project Settings > Service Accounts > Generate new private key
# Option 1: Path to JSON key file
# FIREBASE_SERVICE_ACCOUNT_PATH=/etc/secrets/firebase-service-account.json
# Option 2: Paste entire JSON as a single-line string
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
